# Direnv configuration for OpenShrooly development.
# Auto-creates per-project Python and Node environments when available.

if command -v python3 >/dev/null 2>&1; then
  layout python3
fi

if command -v node >/dev/null 2>&1; then
  layout node
fi

# Ensure project-level binaries are on PATH.
PATH_add node_modules/.bin
PATH_add webapp/node_modules/.bin

# Allow developers to override with local secrets or tweaks.
if [[ -f .envrc.local ]]; then
  source_env ".envrc.local"
fi
